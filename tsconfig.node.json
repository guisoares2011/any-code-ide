{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./out/tsbuildinfo/node.tsbuildinfo",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "electron.vite.config.mts",
    "vitest.config.mts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "e2e/**/*"
  ]
}
